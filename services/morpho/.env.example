# All optional — the service runs keyless on public endpoints.

# Ethereum mainnet RPC. Default: https://ethereum-rpc.publicnode.com
# (viem's default mainnet RPC 429s under light load — publicnode is the
# keyless baseline; use an Alchemy/QuickNode URL in production.)
#ETH_RPC_URL=

# Base RPC. Default: https://base-rpc.publicnode.com
#BASE_RPC_URL=

# Per-IP rate limit on /mcp + /sse (default 60/min).
#RATE_LIMIT_PER_MINUTE=60
